{"credit": "Created by FreshLX for Fresh Animations","id": "player_equipment","animations": [{"var.eqp_bodyrx": "( sin( sqrt(swing_progress)*pi )*0.1 )*(var.rswingingA+var.lswingingA)","var.eqp_bodyry": "( var.attC*0.15 -0.4*var.idle)*(var.rswingingA-var.lswingingA)","var.eqp_bodytx": "( sin( sqrt(swing_progress)*pi )*0.5 +0.2*var.idle )*(var.rswingingA-var.lswingingA)","var.eqp_rarmrx": "-( 0.3 +0.3*var.sneak )*(1-pow(var.gfast,2))*(1-cos(var.requip*pi))/2*(1-var.rswingingA)+torad( ( -10-90*cos(swing_progress *pi ) *var.attA+( head_pitch-0.7 ) )* var.rswingingA +(-18*var.attC +10*var.idle )* var.lswingingA)","var.eqp_larmrx": "-( 0.3 +0.3*var.sneak )*(1-pow(var.gfast,2))*(1-cos(var.lequip*pi))/2*(1-var.lswingingA)+torad( ( -10-90*cos(swing_progress *pi ) *var.attA+( head_pitch-0.7 ) )* var.lswingingA +(-18*var.attC +10*var.idle )* var.rswingingA)","var.eqp_rarmry": " torad( ((-15+25*cos(swing_progress *pi ))*var.attA -10*var.idle +var.hy/1.5*if(is_riding,0.5,1) )* var.rswinging-(-10*var.attC -10*var.idle )* var.lswinging )","var.eqp_larmry": " torad(-((-15+25*cos(swing_progress *pi ))*var.attA -10*var.idle +var.hy/1.5*if(is_riding,0.5,1) )* var.lswinging+(-10*var.attC -10*var.idle )* var.rswinging )","var.eqp_rarmrz": " torad( (-20*sin( (1-swing_progress)*pi ) *var.attA +5 )* var.rswinging-(-5)* var.lswinging )","var.eqp_larmrz": " torad(-(-20*sin( (1-swing_progress)*pi ) *var.attA +5 )* var.lswinging+(-5)* var.rswinging )","var.eqp_rarmtz": "-0.4*var.requip +( ( 2 +2*cos( swing_progress*pi )*var.attA )*(var.rswingingA-var.lswingingA) )*var.rspearhold","var.eqp_larmtz": "-0.4*var.lequip +( ( 2 +2*cos( swing_progress*pi )*var.attA )*(var.lswingingA-var.rswingingA) )*var.lspearhold","var.eqp_rfootrx": "torad( ( 4*var.idle )*var.rswingingA +( sin( sqrt(swing_progress)*pi ) )*var.lswingingA )","var.eqp_lfootrx": "torad( ( 4*var.idle )*var.lswingingA +( sin( sqrt(swing_progress)*pi ) )*var.rswingingA )"},{"var.spr_rarmrx": "torad(-30*var.rspearchrg -20*if(is_using_item, sin(pow(var.rspearchrg,2)*pi), 0 ) )*if(is_right_handed,0,1) -var.mvmnt_rarmrz*(4-6*var.rspearchrg)*var.rspearhold","var.spr_larmrx": "torad(-30*var.lspearchrg -20*if(is_using_item, sin(pow(var.lspearchrg,2)*pi), 0 ) )*if(is_right_handed,0,1) -var.mvmnt_larmrz*(4-6*var.lspearchrg)*var.lspearhold"}]}